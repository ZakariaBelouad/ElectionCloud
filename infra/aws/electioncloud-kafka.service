[Unit]
Description=ElectionCloud Kafka
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/electioncloud-kafka

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/electioncloud/infra/aws
ExecStartPre=/usr/bin/mountpoint -q /srv/electioncloud-kafka
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
